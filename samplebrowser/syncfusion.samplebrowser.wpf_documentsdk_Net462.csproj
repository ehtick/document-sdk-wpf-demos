<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>syncfusion.samplebrowser.wpf</AssemblyName>
    <RootNamespace>syncfusion.samplebrowser.wpf.documentsdk</RootNamespace>
    <TargetFrameworkVersion></TargetFrameworkVersion>
  </PropertyGroup>
  <ItemGroup Condition=" '$(TargetFramework)' == 'net9.0-windows' ">
    <RuntimeHostConfigurationOption Include="System.Windows.Media.UseLegacyResourceReferenceBehavior" Value="true" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="wpf-splash-screen.png" />
    <Resource Include="wpf-documentsdk-splash-screen.png" />
    <None Remove="App.ico" />
    <Compile Remove="AutomationMail.cs" />
    <PackageReference Include="Azure.AI.OpenAI">
      <Version>2.1.0</Version>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI">
      <Version>10.0.1-preview.1.25571.5</Version>
    </PackageReference>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.19" />
    <ProjectReference Include="../Common/syncfusion.demoscommon.wpf_lib_Net462.csproj">
      <Name>syncfusion.demoscommon.wpf_lib</Name>
    </ProjectReference>
    <ProjectReference Include="../docio/syncfusion.dociodemos.wpf_lib_Net462.csproj" />
    <ProjectReference Include="../pdf/syncfusion.pdfdemos.wpf_lib_Net462.csproj" />
    <ProjectReference Include="../presentation/syncfusion.presentationdemos.wpf_lib_Net462.csproj" />
    <ProjectReference Include="../showcase/invoice/syncfusion.invoice.wpf_lib_Net462.csproj" />
    <ProjectReference Include="../showcase/PowerPoint Viewer/syncfusion.powerpointviewer.wpf_lib_Net462.csproj" />
    <ProjectReference Include="../xlsio/syncfusion.xlsiodemos.wpf_lib_Net462.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Binaries_*\**" />
    <EmbeddedResource Remove="Binaries_*\**" />
    <Page Remove="Binaries_*\**" />
    <None Remove="Binaries_*\**" />
  </ItemGroup>
  <PropertyGroup>
    <ApplicationIcon>App.ico</ApplicationIcon>
  </PropertyGroup>
  <Import Project="..\Common\demos.common.props"></Import>
  <Import Project="..\targets\DocumentSDK_Net462.targets" />
  <PropertyGroup Condition=" '$(TargetFramework)'=='net462' ">
    <SyncfusionAssemblyLocation>4.6.2</SyncfusionAssemblyLocation>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(TargetFramework)'=='net8.0-windows' ">
    <SyncfusionAssemblyLocation>net8.0</SyncfusionAssemblyLocation>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(TargetFramework)'=='net9.0-windows' ">
    <SyncfusionAssemblyLocation>net9.0</SyncfusionAssemblyLocation>
  </PropertyGroup>
  <ItemGroup>
    <None Include="packages.config" />
  </ItemGroup>
</Project>