<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <UseWPF>true</UseWPF>
    <AssemblyName>syncfusion.markdowndemos.wpf</AssemblyName>
    <RootNamespace>syncfusion.markdowndemos.wpf</RootNamespace>
    <TargetFrameworkVersion>
    </TargetFrameworkVersion>
  </PropertyGroup>
  <ItemGroup Condition=" '$(TargetFramework)' == 'net9.0-windows' ">
    <RuntimeHostConfigurationOption Include="Switch.System.Windows.Controls.DisableDynamicResourceOptimization" Value="true" />
  </ItemGroup>
  <ItemGroup Condition=" '$(TargetFrameworkIdentifier)' == '.NETFRAMEWORK' ">
    <Reference Include="PresentationFramework.Aero" />
    <Reference Include="System" />
    <Reference Include="System.Data" />
    <Reference Include="System.Xml" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Core" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Xaml">
      <RequiredTargetFramework>4.0</RequiredTargetFramework>
    </Reference>
    <Reference Include="WindowsBase" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../common/syncfusion.demoscommon.wpf_lib_Net80.csproj">
      <Name>syncfusion.demoscommon.wpf_lib</Name>
    </ProjectReference>
    <None Remove="packages.config" />
    <None Include="packages.config" />
    <None Remove="Assets\Markdown\*" />
    <EmbeddedResource Include="Assets\Markdown\*" />
    <Content Include="Assets\Markdown\WordtoMD.docx">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Markdown\MarkdownToWord.md">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Markdown\MarkdownToPPTX.md">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Markdown\PPTXToMarkdown.pptx">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Markdown\ExcelToMarkdownTemplate.xlsx">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Markdown\MarkdownToExcelTemplate.md">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <None Remove="App.config" />
    <Compile Remove="App.xaml.cs" />
    <ApplicationDefinition Remove="App.xaml" />
    <PackageReference Include="Syncfusion.Compression.Base" Version="34.2.2" />
    <PackageReference Include="Syncfusion.DocIO.Wpf" Version="34.2.2" />
    <PackageReference Include="Syncfusion.XlsIO.Wpf" Version="34.2.2" />
    <PackageReference Include="Syncfusion.Presentation.Wpf" Version="34.2.2" />
    <PackageReference Include="Syncfusion.DocToPDFConverter.Wpf" Version="34.2.2" />
    <PackageReference Include="Syncfusion.OfficeChart.Base" Version="34.2.2" />
    <PackageReference Include="Syncfusion.Markdown" Version="34.2.2" />
    <PackageReference Include="Syncfusion.Telemetry" Version="34.2.2" />
    <PackageReference Include="Syncfusion.Pdf.Wpf" Version="34.2.2" />
    <PackageReference Include="Syncfusion.Tools.WPF" Version="34.2.2" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.19" />
  </ItemGroup>
  <Import Project="..\Common\demos.common.props">
  </Import>
  <Import Project="..\targets\MultiTargeting_Net80.targets" />
</Project>